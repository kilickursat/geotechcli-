# =============================================================================
# geotechCLI — Environment Variables
# =============================================================================
# COPY this file to .env.local and fill in real values.
# NEVER commit .env.local to git. It is in .gitignore.
# =============================================================================

# --- LLM Provider Keys (server-side only, NEVER exposed to client) ---
ZHIPU_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Default LLM Provider ---
# Options: zhipu | openai | anthropic | huggingface | openai-compatible
DEFAULT_LLM_PROVIDER=zhipu

# --- Hugging Face (Pro tier — any model from the Hub) ---
HF_TOKEN=

# --- Self-hosted LLM (Ollama, vLLM, etc.) ---
QWEN_VPS_BASE_URL=
QWEN_VPS_API_KEY=
QWEN_VPS_MODEL_ID=qwen3.5-4b

# --- Supabase (User Database) ---
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# --- Upstash Redis (Usage Metering + Rate Limiting) ---
# Get these from: https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...your-token

# --- Stripe (Payments) ---
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook secret from: Stripe Dashboard → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from: Stripe Dashboard → Products → each price's ID
# Create 3 products: Lite Pro ($15/mo), Pro ($49/mo), Annual ($399/yr)
STRIPE_PRICE_LITE_PRO=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ANNUAL=price_...

# --- Proxy / Metering ---
# Shared secret between CLI and proxy (generate: openssl rand -hex 32)
PROXY_SECRET=

# --- Deployment ---
NEXT_PUBLIC_APP_URL=https://geotechcli.com
