# =============================================================================
# geotechCLI Environment Variables
# =============================================================================
# Copy this file to `.env.local` for the website or set the same values in your
# deployment platform. Never commit real secrets.
# =============================================================================

# --- Hosted Beta AI (required for strong-beta deploys) ---
# Cloudflare forwards hosted-beta traffic to Z.ai GLM using this server-side key.
ZHIPU_API_KEY=

# Optional override for Z.ai-compatible deployments. Defaults to https://api.z.ai/api/paas/v4.
ZHIPU_API_BASE_URL=https://api.z.ai/api/paas/v4

# Optional direct endpoint override for GLM-OCR layout parsing. Defaults to $ZHIPU_API_BASE_URL/layout_parsing.
ZHIPU_LAYOUT_PARSING_URL=

# Hosted beta disables GLM thinking by default for lower latency and predictable final content.
# geotechCLI enables thinking per request for final GLM-5.1 report synthesis only.
GEOTECHCLI_HOSTED_BETA_THINKING_MODE=disabled

# Optional JSON override for public hosted-beta limits without a code release.
# Example: {"geotechcli":{"textPerDay":300,"visionPerDay":120,"agentPerDay":40,"layoutPerDay":80}}
GEOTECHCLI_HOSTED_BETA_LIMITS_JSON=

# Optional founder/developer IP allowlist. Exact IPv4/IPv6 entries and IPv4 CIDRs are supported.
GEOTECHCLI_DEVELOPER_IP_ALLOWLIST=

# Hosted beta proxy URL used by the CLI. Override this for staging or local dev.
GEOTECHCLI_PROXY_URL=https://beta.geotechcli.com/api/proxy

# --- Optional Direct Provider Keys (advanced override only) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# --- Self-hosted / OpenAI-compatible LLM (advanced override only) ---
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL_ID=

# --- Upstash Redis (required in production for anonymous limits) ---
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...your-token

# --- Deployment ---
NEXT_PUBLIC_APP_URL=https://beta.geotechcli.com

# --- Deferred Until Full Product Release ---
# Leave these empty until signup, billing, and entitlement flows are enabled.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_LITE_PRO=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ANNUAL=price_...
