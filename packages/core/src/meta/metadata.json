{
  "version": "0.4.5",
  "defaults": {
    "provider": "hosted-beta",
    "model": "Qwen/Qwen2.5-VL-7B-Instruct",
    "visionModel": "Qwen/Qwen2.5-VL-7B-Instruct"
  },
  "proxyModels": ["Qwen/Qwen2.5-VL-7B-Instruct"],
  "globalFlags": [
    {
      "key": "json",
      "option": "--json",
      "description": "Output raw JSON (for piping to jq, scripts, CI)"
    },
    {
      "key": "plot",
      "option": "--plot",
      "description": "Open an interactive engineering plot viewer (browser, with terminal fallback)"
    },
    {
      "key": "saveHtml",
      "option": "--save-html <file>",
      "description": "Write the interactive plot viewer to a specific HTML file"
    },
    {
      "key": "noOpen",
      "option": "--no-open",
      "description": "Generate interactive plot HTML without launching a browser"
    },
    {
      "key": "verbose",
      "option": "--verbose",
      "description": "Show step-by-step calculation details"
    },
    {
      "key": "quiet",
      "option": "--quiet",
      "description": "Suppress all non-essential output"
    },
    {
      "key": "dryRun",
      "option": "--dry-run",
      "description": "Show what would be calculated without executing"
    },
    {
      "key": "output",
      "option": "--output <file>",
      "description": "Save results to file (csv, json)"
    },
    {
      "key": "noColor",
      "option": "--no-color",
      "description": "Disable colored output"
    }
  ]
}
