{
  "name": "@geotechcli/core",
  "version": "0.4.144",
  "description": "Shared computation and LLM engine for geotechCLI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "import": "./dist/llm/index.js"
    },
    "./geo": {
      "types": "./dist/geo/index.d.ts",
      "import": "./dist/geo/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./meta": {
      "types": "./dist/meta/index.d.ts",
      "import": "./dist/meta/index.js"
    },
    "./project-workflow": {
      "types": "./dist/project-workflow/index.d.ts",
      "import": "./dist/project-workflow/index.js"
    },
    "./db/redis": {
      "types": "./dist/db/redis.d.ts",
      "import": "./dist/db/redis.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.99",
    "docx": "^9.0.0",
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "pdfkit": "^0.15.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "files": [
    "NOTICE",
    "dist",
    "bundled-skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kilickursat/geotechcli-.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
