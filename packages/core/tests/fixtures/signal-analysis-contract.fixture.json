{
  "schemaVersion": "signal-analysis-contract-acceptance.v1",
  "description": "Acceptance fixture for deterministic signal-analysis outputs. Signal metrics must stay parser/tool generated, path-safe, and review-gated before any LLM interpretation consumes them.",
  "cases": [
    {
      "signalType": "settlement",
      "fileName": "settlement.csv",
      "thresholdProfile": "settlement-review-mm",
      "valueColumn": "settlement_mm",
      "expectedRateUnit": "per-day",
      "minimumRows": 3,
      "minimumThresholdFlags": 2,
      "minimumMissingIntervals": 1,
      "requiredReviewGates": ["project-trigger-levels-required", "instrument-zero-baseline-required", "unit-confirmation-required"],
      "csv": [
        "timestamp,instrument,settlement_mm",
        "2026-01-01T00:00:00Z,SM-1,0",
        "2026-01-02T00:00:00Z,SM-1,7",
        "2026-01-05T00:00:00Z,SM-1,31"
      ]
    },
    {
      "signalType": "piezometer",
      "fileName": "piezometer.csv",
      "thresholdProfile": "piezometer-review-kpa",
      "valueColumn": "pore_pressure_kpa",
      "expectedRateUnit": "per-day",
      "minimumRows": 3,
      "minimumThresholdFlags": 2,
      "minimumMissingIntervals": 1,
      "requiredReviewGates": ["project-trigger-levels-required", "datum-and-unit-confirmation-required", "seasonal-baseline-review-required"],
      "csv": [
        "timestamp,instrument,pore_pressure_kpa",
        "2026-01-01T00:00:00Z,PZ-1,10",
        "2026-01-02T00:00:00Z,PZ-1,25",
        "2026-01-05T00:00:00Z,PZ-1,62"
      ]
    },
    {
      "signalType": "inclinometer",
      "fileName": "inclinometer.csv",
      "thresholdProfile": "inclinometer-review-mm",
      "valueColumn": "displacement_mm",
      "expectedRateUnit": "per-meter",
      "minimumRows": 3,
      "minimumThresholdFlags": 1,
      "minimumMissingIntervals": 0,
      "requiredReviewGates": ["project-trigger-levels-required", "axis-or-depth-confirmation-required", "casing-baseline-required"],
      "csv": [
        "depth_m,instrument,displacement_mm",
        "0,INC-1,0",
        "5,INC-1,8",
        "10,INC-1,18"
      ]
    },
    {
      "signalType": "vibration",
      "fileName": "vibration.csv",
      "thresholdProfile": "vibration-ppv-review-mm-s",
      "valueColumn": "ppv_mm_s",
      "expectedRateUnit": "per-day",
      "minimumRows": 3,
      "minimumThresholdFlags": 1,
      "minimumMissingIntervals": 0,
      "requiredReviewGates": ["project-trigger-levels-required", "frequency-content-review-required", "asset-sensitivity-review-required"],
      "csv": [
        "timestamp,instrument,ppv_mm_s",
        "2026-01-01T00:00:00Z,VIB-1,1.1",
        "2026-01-01T00:05:00Z,VIB-1,5.4",
        "2026-01-01T00:10:00Z,VIB-1,3.2"
      ]
    },
    {
      "signalType": "load-test",
      "fileName": "pile-load-test.csv",
      "thresholdProfile": "load-test-review-kn",
      "valueColumn": "load_kn",
      "expectedRateUnit": "per-day",
      "minimumRows": 3,
      "minimumThresholdFlags": 1,
      "minimumMissingIntervals": 0,
      "requiredReviewGates": ["test-method-required", "hold-period-criteria-required", "unit-confirmation-required"],
      "csv": [
        "timestamp,instrument,load_kn",
        "2026-01-01T00:00:00Z,PLT-1,0",
        "2026-01-01T01:00:00Z,PLT-1,200",
        "2026-01-01T02:00:00Z,PLT-1,520"
      ]
    }
  ],
  "prohibitedOutputKeys": ["model", "modelCalls", "prompt", "rawPrompt", "llm", "apiKey", "token"],
  "pathSafety": {
    "sourcePathMustBeBasename": true,
    "forbidLocalAbsolutePaths": true,
    "forbidTokenShapedValues": true
  }
}
