      "requiredEvidenceIds": ["ev-strata-1", "ev-spt-1", "ev-gamma-1", "ev-phi-1", "ev-c-1", "ev-gw-1"],
      "requiredSourcePages": [
        { "sourcePath": "site-report.pdf", "pageNumber": 3 },
        { "sourcePath": "site-report.pdf", "pageNumber": 4 },
        { "sourcePath": "site-report.pdf", "pageNumber": 5 }
      ],
      "prohibitedCommandPatterns": ["fem run", "--experimental", "--case-output"]
    },
    {
