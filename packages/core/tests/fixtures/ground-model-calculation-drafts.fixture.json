      "requiredEvidenceIds": ["ev-strata-1", "ev-es-1", "ev-spt-1", "ev-gamma-1"],
      "requiredSourcePages": [
        { "sourcePath": "site-report.pdf", "pageNumber": 3 },
        { "sourcePath": "site-report.pdf", "pageNumber": 4 },
        { "sourcePath": "lab-summary.pdf", "pageNumber": 8 }
      ],
      "prohibitedCommandPatterns": ["fem run", "--experimental", "--case-output"]
    },
    {
      "workflow": "pile-capacity",
