{
  "schemaVersion": "ground-model-calculation-draft-acceptance.v1",
  "description": "Acceptance fixture for opt-in GroundModel-to-calculation input drafts. These are evidence-bound draft inputs only; they must not become automatic design execution or result payloads.",
  "workflows": [
