{
  "name": "@geotechcli/web",
  "version": "0.4.85",
  "private": true,
  "scripts": {
    "dev": "node ../../node_modules/next/dist/bin/next dev",
    "build": "npm run --workspace=@geotechcli/core build && node ../../node_modules/next/dist/bin/next build",
    "start": "node ../../node_modules/next/dist/bin/next start",
    "lint": "node ../../node_modules/next/dist/bin/next lint",
    "clean": "rm -rf .next out .open-next",
    "build:cf": "npm run --workspace=@geotechcli/core build && node ../../node_modules/@opennextjs/cloudflare/dist/cli/index.js build",
    "preview": "npm run build:cf && node ../../node_modules/wrangler/bin/wrangler.js dev",
    "deploy": "npm run build:cf && node ../../node_modules/@opennextjs/cloudflare/dist/cli/index.js deploy",
    "cf-typegen": "node ../../node_modules/wrangler/bin/wrangler.js types ./cloudflare-env.d.ts",
    "cf:check": "node ../../node_modules/wrangler/bin/wrangler.js check"
  },
  "dependencies": {
    "@geotechcli/core": "0.4.85",
    "@opennextjs/cloudflare": "^1.18.0",
    "next": "15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "esbuild": "^0.27.0",
    "postcss": "8.5.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.80.0"
  }
}
